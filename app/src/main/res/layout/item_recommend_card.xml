<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_recommend_card"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/rank_big"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="@color/lol_gold"
        android:textSize="26sp"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:gravity="center" />

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_gold_soft"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/sub_rates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_ink_soft"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/win_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_hex"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/win_label"
            android:textColor="@color/lol_ink_dim"
            android:textSize="10sp"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>
