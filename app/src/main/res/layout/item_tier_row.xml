<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_tier_row"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/rank"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/lol_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="serif" />

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub_rates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_ink_soft"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/win_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lol_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/win_label"
            android:textColor="@color/lol_ink_dim"
            android:textSize="9sp"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>
