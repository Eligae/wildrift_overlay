<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lol_bg"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        style="@style/LolTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="사운드 트리거"
        android:textSize="22sp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/sound_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="@color/lol_ink_soft"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_capture_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🔊 방금 들렸어요 (4초 캡처)" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="저장" />

    <EditText
        android:id="@+id/input_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="라벨 (예: 매치 시작 팡파레)"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spin_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lol_rule"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp" />

    <TextView
        style="@style/LolTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="등록된 트리거"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trigger_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
